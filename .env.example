# Copy this file to .env and adjust. .env is gitignored and must never be
# committed - it carries the JWT signing secret.

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
DB_NAME=ai_civic

# ── Session tokens ───────────────────────────────────────────────────────────
# HMAC-SHA256 signing key for JWTs. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset the app generates a random secret at startup, which means every
# restart invalidates all existing sessions.
JWT_SECRET=

# ── Geolocation (Module 5) ───────────────────────────────────────────────────
# Municipal boundary centroid used for Haversine range validation (Eq. 4).
# Defaults below are Chennai.
MUNICIPAL_LAT=13.0827
MUNICIPAL_LON=80.2707

# Maximum accepted great-circle distance from the centroid, in kilometres.
MUNICIPAL_RADIUS_KM=150

# When true, coordinates outside the radius are REJECTED rather than accepted
# with a warning. Keep false while testing from outside the city.
ENFORCE_BOUNDARY=false

# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT=CivicAI/1.0 (civic issue reporter)
