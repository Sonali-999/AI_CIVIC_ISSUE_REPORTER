"""
civic_classifier.py
-------------------
Local inference for the trained civic-issue classifier.

This is the module that replaces the hosted-LLM API call. It loads the
fine-tuned CNN checkpoint once, keeps it resident, and classifies each
submitted photograph on this machine - no API key, no network round-trip, and
no per-complaint cost.

The checkpoint carries its own class list and department mapping, so the label
order can never drift out of sync with the weights.
"""

from __future__ import annotations

import threading
from pathlib import Path

import torch
import torch.nn.functional as F
from PIL import Image, ImageFile
from torchvision import transforms

from training.config import (
    CHECKPOINT, IMAGE_SIZE, LOW_CONFIDENCE_THRESHOLD, NORM_MEAN, NORM_STD,
    department_for,
)
from training.model import build_model

ImageFile.LOAD_TRUNCATED_IMAGES = True

# Guards lazy initialisation: Gradio serves requests from multiple threads and
# two of them may race to load the model on the first complaint.
_lock = threading.Lock()
_state: dict = {"model": None, "classes": None, "departments": None, "device": None}


class ModelNotTrainedError(RuntimeError):
    """Raised when inference is attempted before a checkpoint exists."""


def _eval_transform() -> transforms.Compose:
    """Must mirror the eval transform used in training/data.py exactly."""
    return transforms.Compose([
        transforms.Resize(int(IMAGE_SIZE * 1.14)),
        transforms.CenterCrop(IMAGE_SIZE),
        transforms.ToTensor(),
        transforms.Normalize(NORM_MEAN, NORM_STD),
    ])


def is_available() -> bool:
    """True when a trained checkpoint exists on disk."""
    return Path(CHECKPOINT).exists()


def _load() -> dict:
    """Load the checkpoint once and cache it."""
    if _state["model"] is not None:
        return _state

    with _lock:
        if _state["model"] is not None:      # another thread won the race
            return _state

        if not is_available():
            raise ModelNotTrainedError(
                f"No trained model at {CHECKPOINT}. Train one with:\n"
                "  python -m training.download_civic\n"
                "  python -m training.prepare_civic\n"
                "  python -m training.train_civic"
            )

        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        blob = torch.load(CHECKPOINT, map_location=device)
        classes = blob["classes"]

        model = build_model(len(classes), arch=blob.get("arch", "resnet18"),
                            pretrained=False)
        model.load_state_dict(blob["state_dict"])
        model.to(device).eval()

        _state.update({
            "model": model,
            "classes": classes,
            # Prefer the mapping frozen into the checkpoint; fall back to the
            # live lookup for checkpoints saved before it was recorded.
            "departments": blob.get("departments")
                           or {c: department_for(c) for c in classes},
            "device": device,
        })
        print(f"[civic_classifier] Loaded {len(classes)} categories on {device}: "
              f"{', '.join(classes)}")

    return _state


def warm_up() -> bool:
    """
    Load the model ahead of the first complaint.

    Called at app start so the first citizen to submit does not pay the
    several-second checkpoint load. Returns False (without raising) when no
    model has been trained yet.
    """
    try:
        _load()
        return True
    except ModelNotTrainedError:
        return False


def classify(image_path: str, top_k: int = 3) -> dict:
    """
    Classify one photograph.

    Returns
    -------
    dict with:
        category        - raw predicted class label
        confidence      - softmax probability of that class (0..1)
        department      - municipal department the category routes to
        low_confidence  - True when confidence is below the review threshold
        top_k           - [(category, probability), ...] for the UI to display
    """
    state = _load()

    with Image.open(image_path) as img:
        tensor = _eval_transform()(img.convert("RGB")).unsqueeze(0)

    with torch.no_grad():
        logits = state["model"](tensor.to(state["device"]))
        probs = F.softmax(logits, dim=1)[0].cpu()

    best = int(probs.argmax())
    category = state["classes"][best]
    confidence = float(probs[best])

    k = min(top_k, len(state["classes"]))
    top_probs, top_idx = torch.topk(probs, k)

    return {
        "category": category,
        "confidence": confidence,
        "department": state["departments"].get(category, department_for(category)),
        "low_confidence": confidence < LOW_CONFIDENCE_THRESHOLD,
        "top_k": [
            (state["classes"][int(i)], float(p))
            for p, i in zip(top_probs, top_idx)
        ],
    }
